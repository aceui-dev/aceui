{
  "name": "@aceuidev/button",
  "version": "0.1.0-beta.0",
  "description": "Versatile button component with multiple variants, sizes, and states for handling user interactions.",
  "keywords": [
    "react",
    "button",
    "component",
    "ui",
    "aceui"
  ],
  "author": "AceUI <support@aceui.dev>",
  "homepage": "https://aceui.dev/components/button",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aceui-dev/aceui.git",
    "directory": "packages/components/button"
  },
  "bugs": {
    "url": "https://github.com/aceui-dev/aceui/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/Button.css",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@react-aria/interactions": "3.26.0",
    "@react-aria/focus": "3.21.3",
    "@react-types/shared": "3.32.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "copyfiles": "^2.4.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "rimraf": "^5.0.10",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "scripts": {
    "build": "tsup src --dts --format esm,cjs && copyfiles -f \"src/*.css\" dist",
    "dev": "tsup src --watch --format esm,cjs",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build"
  }
}